{
  "name": "kirshchenya-portfolio",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kirshchenya.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "kirshchenya-portfolio-media"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "kirshchenya-editorial-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kirshchenya-editorial"
    }
  ]
}
