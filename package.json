{
  "name": "kirshchenya-portfolio",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Kirshchenya portfolio",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test test/*.test.js",
    "build": "astro build",
    "deploy": "npm run build && wrangler deploy",
    "check:bundle": "npm run build && wrangler deploy --dry-run",
    "postdeploy": "node scripts/migrate-editorial.js && npm run check:live",
    "check:live": "node scripts/check-live.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.3.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.125.0"
  }
}
